---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/global/SiteHeader.astro";
import SiteFooter from "../../components/global/SiteFooter.astro";
import HeroEditorial from "../../components/homepage/HeroEditorial.astro";
import AcademicStats from "../../components/homepage/AcademicStats.astro";
import PartnerStrip from "../../components/homepage/PartnerStrip.astro";
import RectorProfile from "../../components/homepage/RectorProfile.astro";
import FacultyMatrix from "../../components/homepage/FacultyMatrix.astro";
import CentersGrid from "../../components/homepage/CentersGrid.astro";
import AdmissionsBlock from "../../components/homepage/AdmissionsBlock.astro";
import NewsroomEditorial from "../../components/homepage/NewsroomEditorial.astro";
import { homepageContent } from "../../data/homepageContent.js";

const content = homepageContent.en;
---

<BaseLayout title={content.title} description={content.description} lang="en">
  <SiteHeader content={content} />
  <main>
    <HeroEditorial content={content} />
    <AcademicStats content={content} />
    <PartnerStrip content={content} />
    <RectorProfile content={content} />
    <FacultyMatrix content={content} />
    <CentersGrid content={content} />
    <AdmissionsBlock content={content} />
    <NewsroomEditorial content={content} />
  </main>
  <SiteFooter content={content} />
</BaseLayout>
