---
import { news } from "../../data/news.js";
---

<section class="section section-soft">
  <div class="container">
    <p class="eyebrow">ARCDEV Newsroom</p>
    <h2 class="section-title">Berita dan Informasi Terkini</h2>
    <p class="section-lead">Ruang informasi resmi untuk berita kampus, agenda akademik, pengumuman, prestasi, dan perkembangan institusi.</p>

    <div class="grid-3" style="margin-top: 36px;">
      {news.map((item) => (
        <article class="card">
          <p class="eyebrow">{item.category}</p>
          <h3>{item.title}</h3>
          <p>{item.date}</p>
        </article>
      ))}
    </div>
  </div>
</section>
