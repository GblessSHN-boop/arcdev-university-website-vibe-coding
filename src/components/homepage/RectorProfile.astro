---
const base = import.meta.env.BASE_URL;

const rector = {
  name: "Gland Siahaan",
  title: "Rektor Universitas ARCDEV Indonesia",
  imageMain: `${base}images/people/rector-gland-siahaan.png`,
  imageReveal: `${base}images/people/rector-gland-siahaan-reveal.png`
};

const batikPattern = `${base}images/patterns/arcdev-batik.svg`;

const batikBanner = `${base}images/patterns/arcdev-batik-banner.png`;
---

<section id="rektor" class="rector-fit-section" style={`--arcdev-batik-banner: url("${batikBanner}");`}>
  <div class="container rector-fit-wrap">
    <div class="rector-fit-media">
      <div class="rector-reveal-card" aria-label="Foto Rektor Universitas ARCDEV Indonesia">
        <img
          src={rector.imageReveal}
          alt=""
          class="rector-fit-photo rector-photo-reveal"
          loading="lazy"
          aria-hidden="true"
        />

        <img
          src={rector.imageMain}
          alt={rector.name}
          class="rector-fit-photo rector-photo-main"
          loading="lazy"
        />
        <span class="rector-hover-label">Rektorat UARCDEV</span>
      </div>
    </div>

    <div class="rector-fit-copy">
      <p class="rector-fit-kicker">Sambutan Rektor</p>
      <h2 class="rector-fit-name">{rector.name}</h2>
      <p class="rector-fit-role">{rector.title}</p>

      <div class="rector-fit-line"></div>

      <p class="rector-fit-text">
        Universitas ARCDEV Indonesia dibangun sebagai kampus teknologi kreatif yang
        menghubungkan software engineering, artificial intelligence, desain digital,
        dan proyek industri nyata.
      </p>

      <a class="rector-fit-link" href="#tentang">Baca Selengkapnya</a>
    </div>
  </div>
</section>

<style>
  .rector-fit-section {
    position: relative;
    overflow: hidden;
    min-height: 390px;
    background:
      radial-gradient(circle at 88% 18%, rgba(147, 91, 255, 0.24), transparent 30%),
      linear-gradient(135deg, #140632 0%, #260b69 52%, #5520bf 100%);
  }
  .rector-fit-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      var(--arcdev-batik),
      var(--arcdev-batik),
      radial-gradient(circle at 82% 16%, rgba(255, 255, 255, 0.12), transparent 30%);
    background-size:
      155px 155px,
      155px 155px,
      100% 100%;
    background-position:
      0 0,
      78px 78px,
      center center;
    background-repeat:
      repeat,
      repeat,
      no-repeat;
    opacity: 0.12;
    mix-blend-mode: screen;
    pointer-events: none;
  }
.rector-fit-wrap {
    position: relative;
    z-index: 1;
    min-height: 390px;
    display: grid;
    grid-template-columns: 360px minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }

  .rector-fit-media {
    height: 390px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: visible;
  }

  .rector-reveal-card {
    --x: 50%;
    --y: 50%;
    --lens-size: 132px;
    --lens-radius: 66px;
    position: relative;
    width: 340px;
    height: 370px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
    cursor: default;
    isolation: isolate;
  }

  .rector-fit-photo {
    display: block;
    width: auto;
    height: auto;
    max-width: 330px;
    max-height: 360px;
    object-fit: contain;
    object-position: center bottom;
    user-select: none;
    pointer-events: none;
  }

  .rector-photo-reveal {
    position: absolute;
    left: 50%;
    bottom: 0;
    z-index: 1;
    transform: translateX(-50%);
    opacity: 0;
    filter:
      drop-shadow(0 16px 28px rgba(0, 0, 0, 0.18))
      saturate(1.02)
      contrast(1.02);
    -webkit-mask-image: radial-gradient(
      circle var(--lens-radius) at var(--x) var(--y),
      rgba(0, 0, 0, 1) 0%,
      rgba(0, 0, 0, 1) 54%,
      rgba(0, 0, 0, 0.62) 72%,
      rgba(0, 0, 0, 0.18) 86%,
      rgba(0, 0, 0, 0) 100%
    );
    mask-image: radial-gradient(
      circle var(--lens-radius) at var(--x) var(--y),
      rgba(0, 0, 0, 1) 0%,
      rgba(0, 0, 0, 1) 54%,
      rgba(0, 0, 0, 0.62) 72%,
      rgba(0, 0, 0, 0.18) 86%,
      rgba(0, 0, 0, 0) 100%
    );
    transition: opacity 0.2s ease;
  }

  .rector-photo-main {
    position: relative;
    z-index: 2;
    filter: drop-shadow(0 16px 28px rgba(0, 0, 0, 0.22));
    transition: filter 0.22s ease;
  }

  .rector-reveal-card.is-revealing .rector-photo-main {
    -webkit-mask-image: radial-gradient(
      circle calc(var(--lens-radius) + 8px) at var(--x) var(--y),
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 0) 54%,
      rgba(0, 0, 0, 0.28) 72%,
      rgba(0, 0, 0, 0.78) 88%,
      rgba(0, 0, 0, 1) 100%
    );
    mask-image: radial-gradient(
      circle calc(var(--lens-radius) + 8px) at var(--x) var(--y),
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 0) 54%,
      rgba(0, 0, 0, 0.28) 72%,
      rgba(0, 0, 0, 0.78) 88%,
      rgba(0, 0, 0, 1) 100%
    );
    filter:
      drop-shadow(0 16px 28px rgba(0, 0, 0, 0.22))
      saturate(0.98);
  }
.rector-hover-label {
    position: absolute;
    left: 18px;
    bottom: 18px;
    z-index: 4;
    padding: 8px 11px;
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: rgba(20, 6, 50, 0.66);
    border: 1px solid rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(8px);
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.22s ease,
      transform 0.22s ease;
  }

  .rector-reveal-card.is-revealing .rector-photo-reveal {
    opacity: 1;
  }

  .rector-reveal-card.is-revealing
.rector-reveal-card.is-revealing .rector-hover-label {
    opacity: 1;
    transform: translateY(0);
  }

  .rector-fit-copy {
    max-width: 760px;
    color: #ffffff;
    padding-bottom: 4px;
  }

  .rector-fit-kicker {
    margin: 0 0 8px;
    font-size: clamp(2rem, 3vw, 3.1rem);
    line-height: 1.08;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: #ffffff;
  }

  .rector-fit-name {
    margin: 0;
    font-size: clamp(2.35rem, 3.8vw, 4rem);
    line-height: 1;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: #ffffff;
  }

  .rector-fit-role {
    margin: 14px 0 0;
    font-size: 1rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.88);
  }

  .rector-fit-line {
    width: 100%;
    height: 3px;
    margin: 22px 0 22px;
    background: rgba(255, 255, 255, 0.92);
  }

  .rector-fit-text {
    max-width: 720px;
    margin: 0;
    font-size: clamp(1.05rem, 1.35vw, 1.18rem);
    line-height: 1.78;
    font-style: italic;
    color: #ffffff;
  }

  .rector-fit-link {
    display: inline-block;
    margin-top: 18px;
    color: #fff200;
    font-size: 1.02rem;
    font-weight: 800;
    font-style: italic;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .rector-fit-link:hover {
    color: #fff7a3;
  }

  @media (max-width: 1100px) {
    .rector-fit-wrap {
      grid-template-columns: 310px minmax(0, 1fr);
      gap: 36px;
    }

    .rector-reveal-card {
      width: 300px;
      height: 350px;
    }

    .rector-fit-photo {
      max-width: 290px;
      max-height: 340px;
    }
  }

  @media (max-width: 820px) {
    .rector-fit-section {
      min-height: auto;
      padding: 36px 0 0;
    }

    .rector-fit-wrap {
      min-height: auto;
      grid-template-columns: 1fr;
      gap: 22px;
      text-align: center;
    }

    .rector-fit-media {
      order: 2;
      height: auto;
    }

    .rector-fit-copy {
      order: 1;
      max-width: 100%;
    }

    .rector-reveal-card {
      width: 270px;
      height: 320px;
      margin: 0 auto;
    }

    .rector-fit-photo {
      max-width: 260px;
      max-height: 300px;
    }

    .rector-fit-line {
      margin-left: auto;
      margin-right: auto;
    }
  }

/* =========================================================
   ARCDEV BATIK USER BANNER V5
========================================================= */

.rector-fit-section {
  position: relative !important;
  isolation: isolate !important;
  overflow: hidden !important;
  background:
    linear-gradient(135deg, #120527 0%, #251061 48%, #5520bf 100%) !important;
}

.rector-fit-section::before {
  content: "" !important;
  position: absolute !important;
  inset: 0 !important;
  background-image: var(--arcdev-batik-banner) !important;
  background-size: 100% 100% !important;
  background-position: center center !important;
  background-repeat: no-repeat !important;
  opacity: 0.42 !important;
  filter: contrast(1.18) brightness(1.18) saturate(0.95) !important;
  mix-blend-mode: screen !important;
  pointer-events: none !important;
  z-index: 0 !important;
}

.rector-fit-section::after {
  content: "" !important;
  position: absolute !important;
  inset: 0 !important;
  background:
    radial-gradient(circle at 82% 18%, rgba(151, 92, 255, 0.22), transparent 34%),
    linear-gradient(135deg, rgba(18, 5, 39, 0.72) 0%, rgba(37, 16, 97, 0.58) 50%, rgba(85, 32, 191, 0.48) 100%) !important;
  pointer-events: none !important;
  z-index: 1 !important;
}

.rector-fit-section > * {
  position: relative !important;
  z-index: 2 !important;
}

/* =========================================================
   END ARCDEV BATIK USER BANNER V5
========================================================= */

</style>

<script is:inline>
  (() => {
    const cards = document.querySelectorAll(".rector-reveal-card");

    cards.forEach((card) => {
      let raf = null;
      let nextX = 0;
      let nextY = 0;

      const applyLens = () => {
        card.style.setProperty("--x", `${nextX}px`);
        card.style.setProperty("--y", `${nextY}px`);
        raf = null;
      };

      const moveLens = (event) => {
        const photo = card.querySelector(".rector-photo-main");
        const rect = photo ? photo.getBoundingClientRect() : card.getBoundingClientRect();

        nextX = event.clientX - rect.left;
        nextY = event.clientY - rect.top;

        if (!raf) {
          raf = requestAnimationFrame(applyLens);
        }
      };

      card.addEventListener("pointerenter", (event) => {
        card.classList.add("is-revealing");
        moveLens(event);
      });

      card.addEventListener("pointermove", moveLens);

      card.addEventListener("pointerleave", () => {
        card.classList.remove("is-revealing");
      });
    });
  })();
</script>








