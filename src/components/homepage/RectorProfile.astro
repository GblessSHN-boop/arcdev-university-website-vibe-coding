---
const base = import.meta.env.BASE_URL;

const rector = {
  name: "Gland Siahaan",
  title: "Rektor Universitas ARCDEV Indonesia",
  image: `${base}images/people/rector-gland-siahaan.png`
};
---

<section id="rektor" class="rector-fit-section">
  <div class="container rector-fit-wrap">
    <div class="rector-fit-media">
      <img
        src={rector.image}
        alt={rector.name}
        class="rector-fit-photo"
        loading="lazy"
      />
    </div>

    <div class="rector-fit-copy">
      <p class="rector-fit-kicker">Sambutan Rektor</p>
      <h2 class="rector-fit-name">{rector.name}</h2>
      <p class="rector-fit-role">{rector.title}</p>

      <div class="rector-fit-line"></div>

      <p class="rector-fit-text">
        Universitas ARCDEV Indonesia dibangun sebagai kampus teknologi kreatif yang
        menghubungkan software engineering, artificial intelligence, desain digital,
        dan proyek industri nyata.
      </p>

      <a class="rector-fit-link" href="#tentang">Baca Selengkapnya</a>
    </div>
  </div>
</section>

<style>
  .rector-fit-section {
    position: relative;
    overflow: hidden;
    min-height: 390px;
    background:
      radial-gradient(circle at 88% 18%, rgba(147, 91, 255, 0.24), transparent 30%),
      linear-gradient(135deg, #140632 0%, #260b69 52%, #5520bf 100%);
  }

  .rector-fit-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.13) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.25;
    pointer-events: none;
  }

  .rector-fit-wrap {
    position: relative;
    z-index: 1;
    min-height: 390px;
    display: grid;
    grid-template-columns: 360px minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }

  .rector-fit-media {
    height: 390px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: visible;
  }

  .rector-fit-photo {
    display: block;
    width: auto;
    height: auto;
    max-width: 330px;
    max-height: 360px;
    object-fit: contain;
    object-position: center bottom;
    filter: drop-shadow(0 16px 28px rgba(0, 0, 0, 0.22));
  }

  .rector-fit-copy {
    max-width: 760px;
    color: #ffffff;
    padding-bottom: 4px;
  }

  .rector-fit-kicker {
    margin: 0 0 8px;
    font-size: clamp(2rem, 3vw, 3.1rem);
    line-height: 1.08;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: #ffffff;
  }

  .rector-fit-name {
    margin: 0;
    font-size: clamp(2.35rem, 3.8vw, 4rem);
    line-height: 1;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: #ffffff;
  }

  .rector-fit-role {
    margin: 14px 0 0;
    font-size: 1rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.88);
  }

  .rector-fit-line {
    width: 100%;
    height: 3px;
    margin: 22px 0 22px;
    background: rgba(255, 255, 255, 0.92);
  }

  .rector-fit-text {
    max-width: 720px;
    margin: 0;
    font-size: clamp(1.05rem, 1.35vw, 1.18rem);
    line-height: 1.78;
    font-style: italic;
    color: #ffffff;
  }

  .rector-fit-link {
    display: inline-block;
    margin-top: 18px;
    color: #fff200;
    font-size: 1.02rem;
    font-weight: 800;
    font-style: italic;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .rector-fit-link:hover {
    color: #fff7a3;
  }

  @media (max-width: 1100px) {
    .rector-fit-wrap {
      grid-template-columns: 310px minmax(0, 1fr);
      gap: 36px;
    }

    .rector-fit-photo {
      max-width: 290px;
      max-height: 340px;
    }
  }

  @media (max-width: 820px) {
    .rector-fit-section {
      min-height: auto;
      padding: 36px 0 0;
    }

    .rector-fit-wrap {
      min-height: auto;
      grid-template-columns: 1fr;
      gap: 22px;
      text-align: center;
    }

    .rector-fit-media {
      order: 2;
      height: auto;
    }

    .rector-fit-copy {
      order: 1;
      max-width: 100%;
    }

    .rector-fit-photo {
      max-width: 260px;
      max-height: 300px;
    }

    .rector-fit-line {
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>
