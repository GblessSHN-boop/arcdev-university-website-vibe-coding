---
const { content } = Astro.props;
const rector = content.rector;
---

<section class="rector-v2 section-pad" id="rector">
  <div class="container rector-grid">
    <div class="rector-visual" data-reveal>
      <img src={rector.photo} alt={rector.name} />
    </div>

    <div class="rector-copy" data-reveal>
      <span>Rector Profile</span>
      <h2>{rector.name}</h2>
      <h3>{rector.role}</h3>
      <p>{rector.summary}</p>

      <div class="rector-columns">
        <div>
          <strong>Education</strong>
          <ul>
            {rector.education.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>

        <div>
          <strong>Professional Background</strong>
          <ul>
            {rector.career.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>

      <div class="expertise-list">
        {rector.expertise.map((item) => (
          <span>{item}</span>
        ))}
      </div>
    </div>
  </div>
</section>
