---
const base = import.meta.env.BASE_URL;

const rector = {
  name: "Gland Siahaan",
  image: `${base}images/people/rector-gland-siahaan.png`
};
---

<section id="rektor" class="sambutan-rektor">
  <div class="sambutan-wrapper">
    <div class="sambutan-image-column">
      <img
        class="sambutan-image"
        src={rector.image}
        alt={rector.name}
        width="902"
        height="855"
        loading="lazy"
      />
    </div>

    <div class="sambutan-text-column">
      <p class="sambutan-title">
        Sambutan Rektor
        <strong>{rector.name}</strong>
      </p>

      <div class="sambutan-separator"></div>

      <p class="sambutan-description">
        Universitas ARCDEV Indonesia dibangun sebagai kampus teknologi kreatif yang
        menghubungkan software engineering, artificial intelligence, desain digital,
        dan proyek industri nyata.
      </p>

      <p class="sambutan-link-wrap">
        <a class="sambutan-link" href="#tentang">
          Baca Selengkapnya
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap");

  :root {
    --arcdev-purple: #4b1fa6;
    --arcdev-purple-dark: #17072f;
    --white: #ffffff;
    --yellow: #ffff00;
  }

  .sambutan-rektor {
    width: 100%;
    height: 500px;
    margin-bottom: 0;
    background-color: var(--arcdev-purple);
    background-image:
      radial-gradient(circle at 18% 22%, rgba(255, 255, 255, 0.10) 1px, transparent 1px),
      linear-gradient(135deg, var(--arcdev-purple-dark) 0%, #29105d 48%, var(--arcdev-purple) 100%);
    background-position: center center;
    background-repeat: repeat, no-repeat;
    background-size: 26px 26px, cover;
    overflow: hidden;
  }

  .sambutan-wrapper {
    display: grid;
    grid-template-columns: 48% 52%;
    align-items: stretch;
    width: min(100%, 1497.6px);
    height: 500px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .sambutan-image-column {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    height: 500px;
    overflow: hidden;
  }

  .sambutan-image {
    display: block;
    width: 510px;
    max-width: 100%;
    height: auto;
    margin-bottom: 0;
    filter: drop-shadow(0 18px 28px rgba(0, 0, 0, 0.22));
  }

  .sambutan-text-column {
    padding-top: 83px;
    padding-left: 20px;
    color: var(--white);
    font-family: "Montserrat", Arial, Helvetica, sans-serif;
  }

  .sambutan-title {
    margin: 0;
    color: var(--white);
    font-size: 38px;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: 0.02em;
  }

  .sambutan-title strong {
    display: block;
    margin-top: 6px;
    color: var(--white);
    font-size: 38px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: 0.05em;
  }

  .sambutan-separator {
    width: 100%;
    height: 3px;
    margin: 28px 0 28px;
    background: var(--white);
  }

  .sambutan-description {
    max-width: 760px;
    margin: 0;
    color: var(--white);
    font-size: 22px;
    font-style: italic;
    font-weight: 400;
    line-height: 2.05;
    letter-spacing: 0.025em;
  }

  .sambutan-link-wrap {
    margin-top: 16px;
    color: var(--white);
    font-size: 17px;
    font-style: italic;
    font-weight: 400;
    line-height: 1.4;
  }

  .sambutan-link {
    color: var(--yellow);
    text-decoration: underline;
    text-underline-offset: 2px;
    font-weight: 700;
  }

  .sambutan-link:hover {
    color: #fff7a3;
  }

  @media (max-width: 1100px) {
    .sambutan-wrapper {
      padding: 0 32px;
    }

    .sambutan-image {
      width: 455px;
    }

    .sambutan-text-column {
      padding-top: 76px;
    }

    .sambutan-title,
    .sambutan-title strong {
      font-size: 32px;
    }

    .sambutan-description {
      font-size: 20px;
      line-height: 1.9;
    }
  }

  @media (max-width: 768px) {
    .sambutan-rektor {
      height: auto;
      min-height: 0;
    }

    .sambutan-wrapper {
      display: flex;
      flex-direction: column;
      height: auto;
      padding: 32px 24px 0;
    }

    .sambutan-text-column {
      order: 1;
      padding-top: 0;
      padding-left: 0;
    }

    .sambutan-image-column {
      order: 2;
      height: auto;
      margin-top: 10px;
    }

    .sambutan-image {
      width: 360px;
    }

    .sambutan-title,
    .sambutan-title strong {
      font-size: 28px;
      line-height: 1.3;
    }

    .sambutan-separator {
      margin: 22px 0;
    }

    .sambutan-description {
      font-size: 18px;
      line-height: 1.65;
    }

    .sambutan-link-wrap {
      font-size: 16px;
    }
  }

  @media (max-width: 480px) {
    .sambutan-wrapper {
      padding: 28px 18px 0;
    }

    .sambutan-title,
    .sambutan-title strong {
      font-size: 24px;
    }

    .sambutan-description {
      font-size: 16px;
    }

    .sambutan-image {
      width: 310px;
    }
  }
</style>
