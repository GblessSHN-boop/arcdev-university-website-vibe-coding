---
const { content } = Astro.props;
---

<section class="faculty-v2 section-pad" id="faculties">
  <div class="container">
    <div class="section-heading-v2" data-reveal>
      <span>02 / Academic Ecosystem</span>
      <h2>{content.lang === "id" ? "Dua Belas Fakultas untuk Teknologi, Desain, AI, dan Industri Masa Depan" : "Twelve Faculties for Technology, Design, AI, and Future Industry"}</h2>
      <p>{content.lang === "id" ? "Setiap fakultas memiliki fokus akademik yang jelas agar sistem informasi, teknik informatika, AI, DKV, media digital, UI/UX, bisnis digital, Web3, quantum, space technology, chip, dan digital twin tidak tercampur secara akademik." : "Each faculty has a clear academic focus, ensuring that information systems, informatics engineering, AI, visual design, digital media, UI/UX, digital business, Web3, quantum, space technology, chip design, and digital twin are academically distinct."}</p>
    </div>

    <div class="faculty-matrix">
      {content.faculties.map((faculty) => (
        <article class="faculty-card-v2" data-reveal>
          <div class="faculty-card-top">
            <span>{faculty.code}</span>
            <small>{content.lang === "id" ? "Academic Faculty" : "Academic Faculty"}</small>
          </div>

          <div>
            <h3>{faculty.title}</h3>
            <strong>{faculty.english}</strong>
            <p>{faculty.text}</p>

            <ul class="faculty-program-list">
              {faculty.programs.map((program) => (
                <li>{program}</li>
              ))}
            </ul>
          </div>

          <a href={faculty.href}>{content.lang === "id" ? "Lihat Fakultas" : "View Faculty"}</a>
        </article>
      ))}
    </div>
  </div>
</section>
