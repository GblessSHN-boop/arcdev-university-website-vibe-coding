---
const { page, lang = "id" } = Astro.props;
const isEn = lang === "en";
const homeHref = isEn ? "/en" : "/id";
const otherLangHref = isEn ? "/id" : "/en";
---

<div class="arc-static-page">
  <header class="arc-page-header">
    <a class="arc-page-brand" href={homeHref}>
      <img src="/images/brand/arcdev-logo.png" alt="ARCDEV logo" />
      <span>
        <strong>{isEn ? "ARCDEV University" : "Universitas ARCDEV"}</strong>
        <small>Creative Technology University</small>
      </span>
    </a>

    <nav>
      <a href={homeHref}>{isEn ? "Home" : "Beranda"}</a>
      <a href={isEn ? "/en/faculties" : "/id/fakultas"}>{isEn ? "Faculties" : "Fakultas"}</a>
      <a href={isEn ? "/en/admissions" : "/id/penerimaan-mahasiswa-baru"}>{isEn ? "Admissions" : "PMB"}</a>
      <a href={otherLangHref}>{isEn ? "ID" : "EN"}</a>
    </nav>
  </header>

  <main>
    <section class="arc-static-hero">
      <div class="arc-static-hero-copy reveal">
        <p>{page.eyebrow}</p>
        <h1>{page.title}</h1>
        <span>{page.lead}</span>
        <a href={page.ctaHref}>{page.cta}</a>
      </div>

      <aside class="arc-static-panel reveal" data-interactive-card>
        <strong>UARCDEV</strong>
        <p>
          Academic Research & Creative Development, kampus teknologi kreatif untuk coding,
          desain, AI, produk digital, dan inovasi industri masa depan.
        </p>
      </aside>
    </section>

    <section class="arc-static-content">
      {page.sections.map((section, index) => (
        <article class="arc-static-card reveal" data-interactive-card>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <h2>{section.title}</h2>
          <p>{section.body}</p>
        </article>
      ))}
    </section>
  </main>

  <footer class="arc-static-footer">
    <p>Copyright © 2026 Universitas ARCDEV Indonesia.</p>
    <a href={homeHref}>{isEn ? "Back to homepage" : "Kembali ke beranda"}</a>
  </footer>
</div>
