---
const { page, lang = "id" } = Astro.props;
const isEn = lang === "en";
const homeHref = isEn ? "/en" : "/id";
const switchHref = isEn ? "/id" : "/en";
const facultyHref = isEn ? "/en/faculties" : "/id/fakultas";
const admissionHref = isEn ? "/en/admissions" : "/id/penerimaan-mahasiswa-baru";
---

<div class="q-static">
  <header class="q-header">
    <a class="q-brand" href={homeHref}>
      <img src="/images/brand/arcdev-logo.png" alt="ARCDEV logo" />
      <span>
        <strong>{isEn ? "ARCDEV University" : "Universitas ARCDEV"}</strong>
        <small>Creative Technology University</small>
      </span>
    </a>

    <nav class="q-nav">
      <a href={homeHref}>{isEn ? "Home" : "Beranda"}</a>
      <a href={facultyHref}>{isEn ? "Faculties" : "Fakultas"}</a>
      <a href={admissionHref}>{isEn ? "Admissions" : "PMB"}</a>
    </nav>

    <div class="q-actions">
      <a class="q-lang" href={switchHref}>{isEn ? "ID" : "EN"}</a>
    </div>
  </header>

  <main>
    <section class="q-static-hero">
      <div data-reveal>
        <p class="q-kicker">{page.eyebrow}</p>
        <h1>{page.title}</h1>
        <p>{page.lead}</p>
        <a href={page.ctaHref}>{page.cta}</a>
      </div>

      <aside data-reveal data-interactive-card>
        <strong>UARCDEV</strong>
        <p>Academic Research & Creative Development.</p>
        <span>Architecture Development for digital technology.</span>
      </aside>
    </section>

    <section class="q-static-grid">
      {page.sections.map(([title, body], index) => (
        <article data-reveal data-interactive-card>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <h2>{title}</h2>
          <p>{body}</p>
        </article>
      ))}
    </section>
  </main>
</div>
