---
import "../styles/global.css";

const {
  title = "ARCDEV University",
  description = "Website resmi konseptual Universitas ARCDEV.",
  lang = "id"
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#4B1FA6" />
    <link rel="icon" type="image/png" href="/images/brand/arcdev-logo.png" />
    <link rel="apple-touch-icon" href="/images/brand/arcdev-logo.png" />
    <title>{title}</title>
  </head>
  <body>
    <slot />

    <script>
      import "../scripts/main.js";
    </script>
  </body>
</html>
